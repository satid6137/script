# Database
DB_HOST=localhost   # IP หรือ Host ของฐานข้อมูล
DB_NAME=xxx         # ชื่อฐานข้อมูลสำหรับเก็บข้อมูล
DB_USER=xxx         # ชื่อผู้ใช้ที่มีสิทธิ์สำหรับฐานข้อมูล
DB_PASS=xxx         # รหัสผ่านของ DB_USER
DB_PORT=3306        # Port ฐานข้อมูลสำหรับเก็บข้อมูล

# Server
IP_SERVER=http://xxx.xxx.xxx.xxx:xxxx   # IP ของ NodeJS Server
HOS_CODE=xxxxx1                         # รหัส 5 หลักหน่วยงาน
API_KEY=xxx                             # รหัสลับที่ต้องตรงกับ NodeJS Server
SUMMARY_KEY=xxx                         # รหัสลับที่ต้องตรงกับ NodeJS Server
NODEJS_URL=http://xxx:xxxx              # URL ของ NodeJS Server พร้อม Port เช่น http://xx.xx.xx.xx:1234 
HOSPITAL_NAME="xxx"                     # ชื่อหน่วยงาน

DB_PHP=xxx.xxx.xxx.xxx   # ip ที่เก็บไฟล์ของ scriptสามารถเป็น IP ภายในได้
IP_NODEJS=http://xxx.xxx.xxx.xxx:xxxx   # ip nodejs สามารถเป็น IP ภายในได้ หากหน่วยงานไม่สามารถมองเห็น ip public ของตนเองได้

# Session
SESSION_NAME=script         # เปลี่ยนตามชื่อโฟลเดอร์ที่ใช้ทำเว็บไซต์
SESSION_PATH=/script        # เปลี่ยนตามชื่อโฟลเดอร์ที่ใช้ทำเว็บไซต์
SESSION_SECURE=false        # ถ้าเว็บไซต์เป็ฺน https ใช้ true / ถ้าเป็น http ใช้ false
SESSION_SAMESITE=Lax